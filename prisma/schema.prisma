// Schéma Prisma GIMMO — MVP V1
// Hébergé sur Supabase (PostgreSQL)
// Voir .env.local pour les variables de connexion

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Simulation {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ── Étape 1 : Intention projet ──────────────────────────────────────────────
  projectStage String? // 'thinking' | 'identified' | 'owner' | 'restructure'
  mainGoal     String? // 'cashflow' | 'patrimoine' | 'transmission' | 'retraite' | 'impots'
  locationType String  // 'nue' | 'meublee_ld' | 'meublee_tourisme_classe' | 'meublee_tourisme_nc' | 'saisonniere'

  // ── Étape 2 : Situation personnelle ────────────────────────────────────────
  familySituation        String // 'celibataire' | 'couple'
  childrenCount          Int    @default(0)
  householdIncome        Float  // Revenu net imposable hors immo (€/an)
  existingMeubleRevenues Float  @default(0) // Recettes meublées autres biens (€/an) — seuil LMP

  // ── Étape 3 : Le bien ──────────────────────────────────────────────────────
  purchasePrice   Float  // Prix d'acquisition FAI (€)
  propertyType    String // 'ancien' | 'neuf' | 'vefa'
  notaryFees      Float
  renovationWork  Float  @default(0)
  furnitureBudget Float? // Uniquement si meublé
  postalCode      String @default("")

  // ── Étape 4 : Financement ──────────────────────────────────────────────────
  financingMode String // 'loan' | 'cash'
  downPayment   Float  @default(0)
  loanAmount    Float  @default(0)
  loanDuration  Int    @default(20)
  interestRate  Float  @default(0)
  insuranceRate Float  @default(0)

  // ── Étape 5 : Exploitation ─────────────────────────────────────────────────
  monthlyRent    Float
  vacancyRate    Float @default(0.04)
  condoFees      Float @default(0)
  propertyTax    Float @default(0)
  pnoInsurance   Float @default(0)
  managementFees Float @default(0)
  maintenancePct Float @default(0.05)
  holdingPeriod  Int   @default(20)

  // ── Résultats (JSON pour flexibilité) ──────────────────────────────────────
  results           Json?   // Array de RegimeResult (summary)
  recommendedRegime String? // Clé du régime recommandé
  isLmpTriggered    Boolean @default(false)

  // ── Lead ───────────────────────────────────────────────────────────────────
  email           String?
  gdprConsent     Boolean   @default(false)
  newsletterOptIn Boolean   @default(false)
  completedAt     DateTime? // Quand l'email a été soumis

  // ── Tracking UTM ───────────────────────────────────────────────────────────
  utmSource   String?
  utmMedium   String?
  utmCampaign String?

  lead Lead? @relation("LeadSimulations", fields: [email], references: [email])

  @@index([email])
  @@index([createdAt])
}

model Lead {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  email           String  @unique
  gdprConsent     Boolean
  newsletterOptIn Boolean @default(false)
  simulationCount Int     @default(0)

  simulations Simulation[] @relation("LeadSimulations")

  @@index([email])
}
