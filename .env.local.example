# ─────────────────────────────────────────────────────────────────────────────
# GIMMO — Variables d'environnement
# Copier ce fichier en .env.local et remplir les valeurs
# NE JAMAIS committer .env.local
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase / PostgreSQL ─────────────────────────────────────────────────────
# Récupérer depuis : Supabase Dashboard > Settings > Database > Connection string
# Utiliser le mode "Transaction" pour DATABASE_URL (port 6543 - pooler)
# Utiliser le mode "Direct" pour DIRECT_URL (port 5432 - migrations Prisma)
DATABASE_URL="postgresql://postgres.XXXX:[PASSWORD]@aws-0-eu-west-3.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.XXXX:[PASSWORD]@aws-0-eu-west-3.pooler.supabase.com:5432/postgres"

# ── Supabase API ──────────────────────────────────────────────────────────────
# Récupérer depuis : Supabase Dashboard > Settings > API
NEXT_PUBLIC_SUPABASE_URL="https://XXXX.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJXXXX"
SUPABASE_SERVICE_ROLE_KEY="eyJXXXX"  # JAMAIS exposé côté client

# ── Resend (emails) ───────────────────────────────────────────────────────────
# Créer sur : https://resend.com
RESEND_API_KEY="re_XXXX"
RESEND_FROM_EMAIL="GIMMO <bonjour@gimmo.fr>"

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Analytics (Phase 5) ───────────────────────────────────────────────────────
# NEXT_PUBLIC_POSTHOG_KEY=""
# NEXT_PUBLIC_POSTHOG_HOST="https://app.posthog.com"
